# Line endings: LF in every file, on Windows and Linux alike. Git stores LF and checks out LF whatever core.autocrlf
# says, so a commit never carries line-ending noise; .editorconfig tells the editors the same.
* text=auto eol=lf
# The exceptions, read by Windows tools that want CRLF:
# cmd misreads batch files with LF line ends
*.cmd text eol=crlf
*.bat text eol=crlf
